# =====================================================================
# Aabhar Studio — environment variables
#
# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these under Project → Settings → Environment Variables,
# separately for Preview and Production.
#
# Only the two NEXT_PUBLIC_ values reach the browser. Everything else is
# server-only (verified: no server value appears in the build output).
# =====================================================================

# --- Supabase (Project Settings → API Keys) -------------------------
NEXT_PUBLIC_SUPABASE_URL=https://eguuncnkcjqmeatrpzcj.supabase.co
# Publishable key (sb_publishable_...) or the legacy "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_l6NnIvtSOxTWgx48GaU7VA_ZE92nE5s
# Secret key (sb_secret_...) or the legacy "service_role" key. SERVER ONLY.
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
# --- Database (SERVER ONLY) ------------------------------------------
# Supabase → Connect → Transaction pooler (port 6543), with your database password.
DATABASE_URL=
# Optional. Connections per server instance (default 5). Keep small on Vercel.
DATABASE_POOL_MAX=
# Recommended (Node: local dev, `next build`, scripts). Supabase's CA certificate,
# so the database certificate and host name are verified. Download it from
# Supabase → Project Settings → Database → SSL Configuration (prod-ca-2021.crt).
# Give a file path (e.g. ./certs/prod-ca-2021.crt) or the PEM text with newlines
# written as \n. Without it the connection is encrypted but NOT verified, and the
# app logs "database.tls_unverified". On Cloudflare Workers DATABASE_URL isn't
# used at all: the app connects through the HYPERDRIVE binding (docs/DEPLOYMENT.md).
DATABASE_SSL_CA=prod-ca-2021.crt

# --- Image provider: OpenAI Images API (SERVER ONLY) -----------------

OPENAI_API_KEY=your_openai_api_key_here
# Optional. Default gpt-image-2.5-sunburst. Also: gpt-image-2.5-flare, gpt-image-2, gpt-image-1.5, gpt-image-1
OPENAI_IMAGE_MODEL=
# Optional. low | medium | high | auto (default high)
OPENAI_IMAGE_QUALITY=
# Optional. Per-attempt timeout in ms (default 140000, max 280000)
OPENAI_TIMEOUT_MS=
# Optional. Override only for a compatible proxy (default https://api.openai.com/v1)
OPENAI_BASE_URL=

# --- Payments: Razorpay (SERVER ONLY) --------------------------------
# Start with TEST keys (rzp_test_...). Dashboard → Account & Settings → API Keys (Test Mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when creating the webhook in the Dashboard (different for test and live).
RAZORPAY_WEBHOOK_SECRET=
# Live keys (rzp_live_...) are refused unless this is "true". Leave false until the
# live configuration is approved (docs/BILLING.md → Going live).
BILLING_LIVE_APPROVED=false

# --- Usage limits (optional) -----------------------------------------
# Fallbacks used only when the database isn't connected; otherwise plan limits apply.
GENERATION_MAX_ACTIVE_JOBS=3
GENERATION_DAILY_LIMIT=200

# --- Scheduled jobs (required on Vercel) -----------------------------
# Protects /api/cron/*. Any random string of 16+ characters: `openssl rand -hex 32`
CRON_SECRET=

# Cloudflare Workers only: protects /api/internal/generation/run, which the
# generation queue consumer calls. 32+ random characters: `openssl rand -hex 32`
# Set it as a Worker secret, not here. Without it the route answers 404.
JOB_RUNNER_SECRET=

# --- Set automatically by Vercel (don't set by hand) -----------------
# VERCEL_GIT_COMMIT_SHA — used to tag error logs and /api/health with the release.

# --- Tests only (never in production) --------------------------------
# A superuser connection to a disposable PostgreSQL server for `npm run test:pg`.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres

# --- Marketing email (SERVER ONLY, optional) -------------------------
# Consent is collected and stored without any of these. Nothing is ever sent
# unless MARKETING_EMAILS_ENABLED=true AND a provider adapter has been built
# (see src/server/marketing/campaigns.ts). Leave false.
MARKETING_EMAILS_ENABLED=false
# resend | brevo | mailchimp (no adapter exists yet)
MARKETING_EMAIL_PROVIDER=
# Public site URL for unsubscribe links, e.g. https://your-domain.example
PUBLIC_SITE_URL=

# --- Runtime self-test (optional, never in normal production) ---------
# Enables GET /api/internal/selftest, which runs the image and PDF pipelines
# in the current runtime (Cloudflare Workers or Node) and reports the results.
# The request must send the same value in `x-selftest-secret`. Unset = 404.
# For `wrangler dev`, put it in .dev.vars. At least 16 characters.
# SELFTEST_SECRET=
