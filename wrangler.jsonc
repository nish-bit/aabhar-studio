{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "aabhar-studio",
  "compatibility_date": "2026-11-03",
  // nodejs_compat is required by OpenNext (node:crypto, Buffer, AsyncLocalStorage, process.env).
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Serve public/*.html (Google Search Console verification) at its exact path, without redirecting to the extensionless URL.
    "html_handling": "none"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "aabhar-studio"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
